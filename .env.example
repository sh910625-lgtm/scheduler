# Auth.js 세션 암호화 키 — node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID (웹 애플리케이션)
# 승인된 리디렉션 URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Postgres 연결 문자열
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scheduler

# 크론 엔드포인트 보호용 — 생성 방법은 AUTH_SECRET과 동일 (Vercel Cron은 Authorization: Bearer <CRON_SECRET> 헤더를 보냄)
CRON_SECRET=
